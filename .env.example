# Copie este arquivo para ".env" (na raiz do projeto) e preencha com suas credenciais.
# O .env e lido pelo backend Java (dataserver) e pelo servico Python (python-service).
DB_HOST=seu-host.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Opcional: maximo de conexoes do Java com o banco (padrao 5).
# O Supabase (porta 5432, modo sessao) aceita 15 conexoes no total entre todos os servicos.
# DB_POOL_SIZE=5

# Opcional: maximo de conexoes do servico Python com o banco (padrao 3).
# Requisicoes alem desse limite esperam a vez em vez de falhar.
# PYTHON_DB_POOL_MAX=3

# Login (obrigatorio): segredo que assina os tokens. Valor aleatorio com 32+ caracteres.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar o segredo derruba todos os logins ativos.
JWT_SECRET=zt0z5oAR-vqgvIaIkplaESVsRc-V3Jc1yYsmUC_onNQMiHfsyBBPa8WDII8Ys7FG

# Primeiro usuario do sistema (nao existe cadastro aberto). O Java cria esse usuario
# na subida se o e-mail ainda nao existir; depois disso a senha pode sair do .env.
ADMIN_EMAIL=miguelsilvafiaschi@gmail.com
ADMIN_SENHA=Fiaschi0987#

# Opcional: quantas horas o login vale (padrao 8).
# JWT_EXPIRACAO_HORAS=8
